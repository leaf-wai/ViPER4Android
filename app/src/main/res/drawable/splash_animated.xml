<?xml version="1.0" encoding="utf-8"?>
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">

    <aapt:attr name="android:drawable">
        <vector
            android:width="108dp"
            android:height="108dp"
            android:viewportWidth="108"
            android:viewportHeight="108">

            <!-- MIUIX 主题蓝声波扩散圆环 -->
            <group
                android:name="ring1_group"
                android:pivotX="54"
                android:pivotY="54"
                android:scaleX="0.4"
                android:scaleY="0.4">
                <path
                    android:name="ring1"
                    android:pathData="M54,54m-20,0a20,20 0,1 1,40 0a20,20 0,1 1,-40 0"
                    android:strokeColor="#54A6FF"
                    android:strokeWidth="1.2"
                    android:strokeAlpha="0"
                    android:fillColor="#00000000" />
            </group>

            <group
                android:name="ring2_group"
                android:pivotX="54"
                android:pivotY="54"
                android:scaleX="0.4"
                android:scaleY="0.4">
                <path
                    android:name="ring2"
                    android:pathData="M54,54m-20,0a20,20 0,1 1,40 0a20,20 0,1 1,-40 0"
                    android:strokeColor="#3482FF"
                    android:strokeWidth="1"
                    android:strokeAlpha="0"
                    android:fillColor="#00000000" />
            </group>

            <group
                android:name="ring3_group"
                android:pivotX="54"
                android:pivotY="54"
                android:scaleX="0.4"
                android:scaleY="0.4">
                <path
                    android:name="ring3"
                    android:pathData="M54,54m-20,0a20,20 0,1 1,40 0a20,20 0,1 1,-40 0"
                    android:strokeColor="#1B5EEB"
                    android:strokeWidth="0.8"
                    android:strokeAlpha="0"
                    android:fillColor="#00000000" />
            </group>

            <!-- 与应用图标同步的原版 ViPER V 字标志及光学居中定位，填充 MIUIX 主题蓝渐变 -->
            <group
                android:translateX="25.2"
                android:translateY="24.0"
                android:scaleX="1.2"
                android:scaleY="1.2">
                <path
                    android:pathData="M35.56,8l-8.15,19.72l-8.12,-19.71l-0.02,-0.02l-11.27,0l16.09,35.98l15.91,-35.97l-4.44,0z">
                    <aapt:attr name="android:fillColor">
                        <gradient
                            android:type="linear"
                            android:startX="16"
                            android:startY="8"
                            android:endX="32"
                            android:endY="44">
                            <item android:offset="0.0" android:color="#FF54A6FF" />
                            <item android:offset="0.5" android:color="#FF3482FF" />
                            <item android:offset="1.0" android:color="#FF1B5EEB" />
                        </gradient>
                    </aapt:attr>
                </path>
            </group>

        </vector>
    </aapt:attr>

    <target android:name="ring1">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="strokeAlpha"
                android:valueFrom="0.55"
                android:valueTo="0"
                android:valueType="floatType"
                android:startOffset="150"
                android:duration="600"
                android:interpolator="@android:interpolator/decelerate_quad" />
        </aapt:attr>
    </target>

    <target android:name="ring1_group">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:propertyName="scaleX"
                    android:valueFrom="0.4"
                    android:valueTo="1.55"
                    android:valueType="floatType"
                    android:startOffset="150"
                    android:duration="600"
                    android:interpolator="@android:interpolator/decelerate_quad" />
                <objectAnimator
                    android:propertyName="scaleY"
                    android:valueFrom="0.4"
                    android:valueTo="1.55"
                    android:valueType="floatType"
                    android:startOffset="150"
                    android:duration="600"
                    android:interpolator="@android:interpolator/decelerate_quad" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="ring2">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="strokeAlpha"
                android:valueFrom="0.4"
                android:valueTo="0"
                android:valueType="floatType"
                android:startOffset="350"
                android:duration="600"
                android:interpolator="@android:interpolator/decelerate_quad" />
        </aapt:attr>
    </target>

    <target android:name="ring2_group">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:propertyName="scaleX"
                    android:valueFrom="0.4"
                    android:valueTo="1.75"
                    android:valueType="floatType"
                    android:startOffset="350"
                    android:duration="600"
                    android:interpolator="@android:interpolator/decelerate_quad" />
                <objectAnimator
                    android:propertyName="scaleY"
                    android:valueFrom="0.4"
                    android:valueTo="1.75"
                    android:valueType="floatType"
                    android:startOffset="350"
                    android:duration="600"
                    android:interpolator="@android:interpolator/decelerate_quad" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="ring3">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="strokeAlpha"
                android:valueFrom="0.28"
                android:valueTo="0"
                android:valueType="floatType"
                android:startOffset="550"
                android:duration="600"
                android:interpolator="@android:interpolator/decelerate_quad" />
        </aapt:attr>
    </target>

    <target android:name="ring3_group">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator
                    android:propertyName="scaleX"
                    android:valueFrom="0.4"
                    android:valueTo="1.9"
                    android:valueType="floatType"
                    android:startOffset="550"
                    android:duration="600"
                    android:interpolator="@android:interpolator/decelerate_quad" />
                <objectAnimator
                    android:propertyName="scaleY"
                    android:valueFrom="0.4"
                    android:valueTo="1.9"
                    android:valueType="floatType"
                    android:startOffset="550"
                    android:duration="600"
                    android:interpolator="@android:interpolator/decelerate_quad" />
            </set>
        </aapt:attr>
    </target>

</animated-vector>
